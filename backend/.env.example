# =================================================================
# 소상공인 동적 현금흐름 예측 시스템 - 외부 공식 API 키와 환경 변수 설정
# 이 파일을 `.env`로 복사한 뒤 발급받은 API 키를 입력합니다.
# =================================================================

# 1. 한국은행 ECOS Open API 키: https://ecos.bok.or.kr/api/
ECOS_API_KEY=YOUR_ECOS_API_KEY_HERE

# 2. 국가통계포털 KOSIS Open API 키: https://kosis.kr/openapi/
KOSIS_API_KEY=YOUR_KOSIS_API_KEY_HERE

# 3. 관세청·공공데이터포털 API 키: https://www.data.go.kr/
DATA_GO_KR_API_KEY=YOUR_DATA_GO_KR_API_KEY_HERE
CUSTOMS_API_KEY=YOUR_CUSTOMS_API_KEY_HERE
PUBLIC_DATA_API_KEY=YOUR_PUBLIC_DATA_API_KEY_HERE

# 4. 주소를 좌표로 변환하는 Kakao REST API 키: https://developers.kakao.com/
KAKAO_REST_API_KEY=YOUR_KAKAO_REST_API_KEY_HERE

# 5. 보조 지오코딩용 Naver Cloud Platform API 키: https://www.ncloud.com/
NAVER_CLIENT_ID=YOUR_NAVER_CLIENT_ID_HERE
NAVER_CLIENT_SECRET=YOUR_NAVER_CLIENT_SECRET_HERE

# 조사 에이전트 제공자
# 모드: fake(오프라인), auto(두 클라우드 키가 모두 있으면 실제 제공자), real, local, demo_replay.
# demo_replay는 DEMO_DATASET_ID로 선택한 네트워크 미사용 합성 데이터셋을 사용합니다.
RESEARCH_PROVIDER_MODE=fake
GEMINI_API_KEY=
GEMINI_SEARCH_MODEL=gemini-3.6-flash
# 검색 요청별 시간 제한입니다. GEMINI_TIMEOUT_SECONDS는 이전 변수의 대체값으로 유지됩니다.
RESEARCH_SEARCH_REQUEST_TIMEOUT_SECONDS=90
GEMINI_TIMEOUT_SECONDS=90
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-5.6-terra
OPENAI_MAX_OUTPUT_TOKENS=6000
# 추출 요청별 시간 제한입니다. OPENAI_TIMEOUT_SECONDS는 이전 변수의 대체값으로 유지됩니다.
RESEARCH_EXTRACTION_REQUEST_TIMEOUT_SECONDS=180
OPENAI_TIMEOUT_SECONDS=180
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=qwen3.5-27b

# 조사 저장소와 HTTP 안전 설정
RESEARCH_DATABASE_URL=sqlite:///./data/research.db
SOURCE_SNAPSHOT_DIR=./data/source_snapshots
# 문서·첨부파일 요청별 시간 제한입니다. RESEARCH_HTTP_TIMEOUT_SECONDS는 이전 대체값입니다.
RESEARCH_DOCUMENT_FETCH_TIMEOUT_SECONDS=30
RESEARCH_HTTP_TIMEOUT_SECONDS=30
# 0은 선택적인 에이전트 전체 시간 제한을 비활성화하며 작업별·분석 작업 시간 제한은 유지됩니다.
RESEARCH_AGENT_WALL_CLOCK_LIMIT_SECONDS=0
# 전체 비동기 분석 작업에 적용하는 협력적 상한입니다.
ANALYSIS_JOB_TIMEOUT_SECONDS=1800
# 검색 이후 단계를 위한 처리 여유와 공식 정책 시작 URL의 최소 수집량을 확보합니다.
RESEARCH_MIN_DOCUMENTS_AFTER_DISCOVERY=3
RESEARCH_OFFICIAL_SEED_RESERVE=2
RESEARCH_MAX_DOCUMENT_BYTES=5242880
RESEARCH_MAX_REDIRECTS=3
RESEARCH_MAX_SEARCH_RETRIES=1
RESEARCH_MAX_EXTRACTION_RETRIES=1
RESEARCH_MAX_LOCAL_CHILD_PAGES=6

# 제공자 토큰 100만 개당 USD 단가입니다. 실제 사용 모델의 최신 단가로 갱신합니다.
GEMINI_INPUT_COST_PER_MILLION_USD=0
GEMINI_OUTPUT_COST_PER_MILLION_USD=0
GEMINI_CACHED_COST_PER_MILLION_USD=0
OPENAI_INPUT_COST_PER_MILLION_USD=0
OPENAI_OUTPUT_COST_PER_MILLION_USD=0
OPENAI_CACHED_COST_PER_MILLION_USD=0

APP_ENV=development
# FastAPI
API_HOST=127.0.0.1
API_PORT=8000
CORS_ALLOWED_ORIGINS=
API_AUTH_MODE=none
API_AUTH_KEY=
RATE_LIMIT_PER_MINUTE=0

# 버전 관리되는 분석 파이프라인
# 예약값입니다. 현재 공식 데이터 제공자는 요청과 등록된 어댑터에 따라 결정됩니다.
OFFICIAL_DATA_PROVIDER_MODE=auto
DB_SCHEMA_MODE=auto
# 현재 구현은 in_process만 지원하며 운영용 외부 큐 연결은 아직 지원하지 않습니다.
JOB_RUNNER_MODE=in_process
# 외부 큐 배포를 위한 예약값이며 현재 FastAPI 초기화 과정에는 연결되지 않습니다.
REDIS_URL=
# 읽어들이는 보존 정책 값이며 자동 삭제 작업은 아직 연결되지 않았습니다.
RESULT_RETENTION_DAYS=365
RAW_SNAPSHOT_RETENTION_DAYS=90
# 현재 API는 single/default 테넌트만 지원합니다.
TENANT_MODE=single
FORECAST_MIN_IMPROVEMENT=0
FORECAST_BACKTEST_WINDOWS=12

# 네트워크를 사용하지 않는 합성 조사 재생이며 기본값은 비활성입니다.
ENABLE_DEMO_DATASETS=0
DEMO_DATASET_ID=cafe-gangnam-festival.v1
# 선택적인 절대 경로입니다. 비워 두면 저장소의 demo/를 사용합니다.
DEMO_DATASET_ROOT=
DEMO_DATASET_API_KEY=
