{
  "$defs": {
    "EligibilityCondition": {
      "additionalProperties": false,
      "properties": {
        "field_path": {
          "title": "Field Path",
          "type": "string"
        },
        "operator": {
          "title": "Operator",
          "type": "string"
        },
        "expected_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "field_path",
        "operator"
      ],
      "title": "EligibilityCondition",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_revision_id": {
          "title": "Source Revision Id",
          "type": "string"
        },
        "field_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Field Paths",
          "type": "array"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "start_offset": {
          "minimum": 0,
          "title": "Start Offset",
          "type": "integer"
        },
        "end_offset": {
          "exclusiveMinimum": 0,
          "title": "End Offset",
          "type": "integer"
        }
      },
      "required": [
        "evidence_id",
        "source_id",
        "source_revision_id",
        "field_paths",
        "quote",
        "start_offset",
        "end_offset"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "GuaranteeTerms": {
      "additionalProperties": false,
      "properties": {
        "coverage_ratio": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage Ratio"
        },
        "guarantee_fee_percent": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Guarantee Fee Percent"
        },
        "collateral_required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collateral Required"
        }
      },
      "title": "GuaranteeTerms",
      "type": "object"
    },
    "InterestTerms": {
      "additionalProperties": false,
      "properties": {
        "annual_rate_percent": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Annual Rate Percent"
        },
        "rate_discount_percentage_points": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Discount Percentage Points"
        }
      },
      "title": "InterestTerms",
      "type": "object"
    },
    "PolicyType": {
      "enum": [
        "LOAN_SUPPORT",
        "CREDIT_GUARANTEE",
        "INTEREST_SUBSIDY",
        "GRANT",
        "REPAYMENT_DEFERRAL",
        "TAX_RELIEF"
      ],
      "title": "PolicyType",
      "type": "string"
    },
    "RepaymentTerms": {
      "additionalProperties": false,
      "properties": {
        "principal_grace_months": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Principal Grace Months"
        },
        "maturity_months": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maturity Months"
        },
        "repayment_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repayment Method"
        }
      },
      "title": "RepaymentTerms",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "policy_candidate_id": {
      "title": "Policy Candidate Id",
      "type": "string"
    },
    "extractor_policy_candidate_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Extractor Policy Candidate Id"
    },
    "identity_fingerprint": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Identity Fingerprint"
    },
    "policy_merge_group_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy Merge Group Id"
    },
    "merged_policy_candidate_ids": {
      "items": {
        "type": "string"
      },
      "title": "Merged Policy Candidate Ids",
      "type": "array"
    },
    "research_run_id": {
      "title": "Research Run Id",
      "type": "string"
    },
    "policy_type": {
      "$ref": "#/$defs/PolicyType"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "provider_raw": {
      "title": "Provider Raw",
      "type": "string"
    },
    "purpose": {
      "items": {
        "type": "string"
      },
      "title": "Purpose",
      "type": "array"
    },
    "region_codes": {
      "items": {
        "type": "string"
      },
      "title": "Region Codes",
      "type": "array"
    },
    "industry_inclusions_raw": {
      "items": {
        "type": "string"
      },
      "title": "Industry Inclusions Raw",
      "type": "array"
    },
    "industry_exclusions_raw": {
      "items": {
        "type": "string"
      },
      "title": "Industry Exclusions Raw",
      "type": "array"
    },
    "limit_krw": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Limit Krw"
    },
    "interest_terms": {
      "$ref": "#/$defs/InterestTerms"
    },
    "guarantee_terms": {
      "$ref": "#/$defs/GuaranteeTerms"
    },
    "repayment_terms": {
      "$ref": "#/$defs/RepaymentTerms"
    },
    "application_start": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Application Start"
    },
    "application_end": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Application End"
    },
    "budget_status": {
      "default": "UNKNOWN",
      "title": "Budget Status",
      "type": "string"
    },
    "application_status": {
      "default": "STATUS_UNCONFIRMED",
      "title": "Application Status",
      "type": "string"
    },
    "recommendation_failure_codes": {
      "items": {
        "type": "string"
      },
      "title": "Recommendation Failure Codes",
      "type": "array"
    },
    "eligibility_conditions": {
      "items": {
        "$ref": "#/$defs/EligibilityCondition"
      },
      "title": "Eligibility Conditions",
      "type": "array"
    },
    "source_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Ids",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "supersedes_policy_candidate_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Policy Candidate Id"
    },
    "notice_kind": {
      "default": "ORIGINAL",
      "title": "Notice Kind",
      "type": "string"
    },
    "validation_status": {
      "default": "EXTRACTED",
      "title": "Validation Status",
      "type": "string"
    },
    "validation_failure_codes": {
      "items": {
        "type": "string"
      },
      "title": "Validation Failure Codes",
      "type": "array"
    },
    "validation_notes": {
      "items": {
        "type": "string"
      },
      "title": "Validation Notes",
      "type": "array"
    },
    "source_validation_details": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Source Validation Details",
      "type": "array"
    },
    "schema_version": {
      "default": "policy_candidate.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "policy_candidate_id",
    "research_run_id",
    "policy_type",
    "name",
    "provider_raw",
    "source_ids",
    "evidence"
  ],
  "title": "PolicyCandidate",
  "type": "object"
}
